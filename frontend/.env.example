# Copy this file to ".env" for local development:
#   cp .env.example .env
#
# The URL of the FastAPI backend.
# Local dev:
VITE_API_URL=http://127.0.0.1:8000
# Once deployed, set this in Vercel's Environment Variables instead,
# pointing at your Render URL, e.g.
# VITE_API_URL=https://campusconnect-backend.onrender.com
