# Copy this file to ".env" for local development:
#   cp .env.example .env
#
# Do NOT commit a real ".env" file with real secrets to GitHub.
# On Render, you will set these same names under the service's
# Environment tab instead of using this file.

# A long random string used to sign login tokens (JWTs).
# Any random text works - for example, run this once and paste the result:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# The URL(s) of the React frontend that are allowed to call this API.
# Local dev:
FRONTEND_URL=http://localhost:5173
# Once deployed, set this in Render to your Vercel URL instead, e.g.
# FRONTEND_URL=https://campusconnect-xxxxx.vercel.app
# You can allow both at once with a comma:
# FRONTEND_URL=http://localhost:5173,https://campusconnect-xxxxx.vercel.app
